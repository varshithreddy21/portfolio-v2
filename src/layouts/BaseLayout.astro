---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { getEntry } from "astro:content";

const profile = (await getEntry("profile", "profile")).data;

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} — ${profile.headline}`,
  description = profile.about,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/images/avatar.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={profile.avatar} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title={`${profile.name}'s Blog`} href="/rss.xml" />
  </head>
  <body class="noise relative min-h-screen">
    <!-- Animated aurora background -->
    <div class="fixed inset-0 -z-10 overflow-hidden">
      <div class="absolute inset-0 grid-bg opacity-40"></div>
      <!-- Aurora blobs -->
      <div
        class="animate-aurora absolute -top-40 -left-40 h-[500px] w-[500px] rounded-full bg-violet/20 blur-[120px]"
      >
      </div>
      <div
        class="animate-aurora absolute top-1/3 -right-40 h-[450px] w-[450px] rounded-full bg-fuchsia/15 blur-[120px]"
        style="animation-delay: -6s;"
      >
      </div>
      <div
        class="animate-aurora absolute bottom-0 left-1/3 h-[400px] w-[400px] rounded-full bg-cyan/10 blur-[120px]"
        style="animation-delay: -12s;"
      >
      </div>
      <!-- Gradient overlay top -->
      <div
        class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-base to-transparent"
      >
      </div>
    </div>

    <!-- Scroll progress bar -->
    <div
      class="fixed top-0 left-0 z-[100] h-[2px] w-full origin-left scale-x-0 bg-gradient-to-r from-violet via-fuchsia to-cyan"
      id="scroll-progress"
    >
    </div>

    <Nav profile={profile} />

    <main>
      <slot />
    </main>

    <Footer profile={profile} />

    <!-- Scroll reveal + scroll progress script -->
    <script>
      // Scroll progress bar
      const progressBar = document.getElementById("scroll-progress");
      const updateProgress = () => {
        const scrolled = window.scrollY;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const ratio = max > 0 ? scrolled / max : 0;
        progressBar?.style.setProperty("transform", `scaleX(${ratio})`);
      };
      window.addEventListener("scroll", updateProgress, { passive: true });
      updateProgress();

      // Intersection Observer for scroll reveals
      const revealEls = document.querySelectorAll(
        ".reveal, .reveal-left, .reveal-right, .reveal-scale"
      );
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              // Stagger children with data-delay
              const delay = entry.target.getAttribute("data-delay");
              if (delay) {
                entry.target.style.transitionDelay = `${delay}ms`;
              }
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: "0px 0px -60px 0px" }
      );
      revealEls.forEach((el) => observer.observe(el));

      // Re-run on Astro view transitions
      document.addEventListener("astro:after-swap", () => {
        const els = document.querySelectorAll(
          ".reveal, .reveal-left, .reveal-right, .reveal-scale"
        );
        els.forEach((el) => {
          el.classList.remove("visible");
          observer.observe(el);
        });
        updateProgress();
      });
    </script>
  </body>
</html>
