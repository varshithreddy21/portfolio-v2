---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogList from "../../components/BlogList.astro";
import Icon from "../../components/Icon.astro";
import { getEntry, getCollection } from "astro:content";

const profile = (await getEntry("profile", "profile")).data;
const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<BaseLayout title={`Blog — ${profile.name}`} description="Thoughts on engineering, cloud architecture, and building at scale.">
  <section class="relative pt-32 pb-12">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <!-- Header -->
      <div class="reveal text-center">
        <div class="mb-3 font-mono text-sm text-violet">
          <span class="text-muted">// blog</span>
        </div>
        <h1 class="font-display text-4xl font-bold tracking-tight text-text sm:text-5xl lg:text-6xl">
          The <span class="text-gradient">Blog</span>
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-muted">
          Thoughts on my professional journey, industry insights, and lessons learned along the way.
        </p>
      </div>

      <!-- Tags filter -->
      <div class="reveal mt-8 flex flex-wrap items-center justify-center gap-2">
        <span class="flex items-center gap-1 text-xs text-dim">
          <Icon name="tag" class="h-3 w-3" />
          Tags:
        </span>
        {
          [...new Set(posts.flatMap((p) => p.data.tags))].map((tag) => (
            <span class="rounded-full border border-border bg-surface-2 px-3 py-1 text-xs text-muted">
              {tag}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <BlogList posts={posts} showAll={true} />
</BaseLayout>
