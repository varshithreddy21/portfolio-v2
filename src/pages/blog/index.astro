---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogList from "../../components/BlogList.astro";
import Icon from "../../components/Icon.astro";
import { getEntry, getCollection } from "astro:content";

const profile = (await getEntry("profile", "profile")).data;
const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const categories = ["All", ...new Set(posts.map((p) => p.data.category))];
---

<BaseLayout title={`Blog — ${profile.name}`} description="Thoughts on my professional journey, industry insights, and lessons learned along the way.">
  <section class="relative pt-32 pb-8">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <!-- Header -->
      <div class="reveal text-center">
        <h1 class="font-display text-4xl font-bold tracking-tight text-text sm:text-5xl lg:text-6xl">
          My <span class="text-gradient">blogs</span>
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-muted">
          Thoughts on my professional journey, industry insights, and lessons learned along the way.
        </p>
      </div>

      <!-- Category filter -->
      <div class="reveal mt-10 flex justify-center">
        <div class="relative">
          <select
            id="category-filter"
            class="appearance-none rounded-xl border border-border bg-surface px-4 py-2.5 pr-10 text-sm font-medium text-text transition-colors hover:border-violet/50 focus:border-violet focus:outline-none focus:ring-1 focus:ring-violet"
          >
            {categories.map((cat) => (
              <option value={cat}>{cat}</option>
            ))}
          </select>
          <Icon name="arrow" class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 rotate-90 text-dim" />
        </div>
      </div>
    </div>
  </section>

  <!-- Posts -->
  <div id="posts-container">
    <BlogList posts={posts} showAll={true} />
  </div>
</BaseLayout>

<script>
  // Category filter
  const filter = document.getElementById("category-filter");
  const cards = document.querySelectorAll("#posts-container a[href^='/blog/']");

  filter?.addEventListener("change", (e) => {
    const selected = (e.target as HTMLSelectElement).value;
    cards.forEach((card) => {
      const cat = card.getAttribute("data-category") || "";
      if (selected === "All" || cat === selected) {
        (card as HTMLElement).style.display = "";
      } else {
        (card as HTMLElement).style.display = "none";
      }
    });
  });
</script>
