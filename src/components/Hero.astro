---
import Icon from "./Icon.astro";

interface Props {
  profile: {
    name: string;
    firstName: string;
    headline: string;
    location: string;
    email: string;
    avatar: string;
    resumeUrl: string;
    about: string;
    socials: Array<{ label: string; url: string; icon: string }>;
  };
}

const { profile } = Astro.props;
---

<section id="home" class="relative flex min-h-screen items-center overflow-hidden pt-24">
  <!-- Floating decorative elements -->
  <div class="animate-float absolute top-1/4 left-[10%] hidden h-3 w-3 rounded-full bg-violet/60 blur-[1px] lg:block"></div>
  <div class="animate-float-slow absolute top-1/3 right-[15%] hidden h-4 w-4 rounded-full bg-fuchsia/50 blur-[1px] lg:block"></div>
  <div class="animate-float absolute bottom-1/4 left-[20%] hidden h-2 w-2 rounded-full bg-cyan/70 blur-[1px] lg:block" style="animation-delay: -3s;"></div>
  <div class="animate-float-slow absolute bottom-1/3 right-[8%] hidden h-3 w-3 rounded-full bg-emerald/50 blur-[1px] lg:block" style="animation-delay: -4s;"></div>

  <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 px-6 lg:grid-cols-12 lg:px-8">
    <!-- Left: Text content -->
    <div class="lg:col-span-7">
      <!-- Name -->
      <h1 class="reveal reveal-left delay-2 font-display text-5xl font-bold leading-tight tracking-tight sm:text-6xl lg:text-7xl">
        <span class="text-text">Hi, I'm </span>
        <span class="text-gradient-animated">{profile.name}</span>
      </h1>

      <!-- Headline -->
      <div class="reveal reveal-left delay-3 mt-4 font-display text-2xl font-medium text-muted sm:text-3xl">
        {profile.headline}
      </div>

      <!-- Location -->
      <div class="reveal reveal-left delay-4 mt-4 flex items-center gap-2 text-sm text-dim">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        {profile.location}
      </div>

      <!-- Description -->
      <p class="reveal reveal-left delay-5 mt-6 max-w-2xl text-base leading-relaxed text-muted sm:text-lg whitespace-pre-line">
        {profile.about}
      </p>

      <!-- Socials -->
      <div class="reveal reveal-left delay-6 mt-8 flex items-center gap-3">
        {
          profile.socials.map((social) => (
            <a
              href={social.icon === "mail" ? "#contact" : social.url}
              target={social.icon === "mail" ? undefined : "_blank"}
              rel={social.icon === "mail" ? undefined : "noopener noreferrer"}
              class="flex h-10 w-10 items-center justify-center rounded-lg border border-border bg-surface/50 text-muted transition-all hover:border-violet/50 hover:text-violet hover:shadow-md hover:shadow-violet/10"
              aria-label={social.label}
            >
              <Icon name={social.icon} class="h-4 w-4" />
              <span class="sr-only">{social.label}</span>
            </a>
          ))
        }
      </div>
    </div>

    <!-- Right: Avatar / visual -->
    <div class="reveal reveal-scale delay-3 lg:col-span-5">
      <div class="relative mx-auto max-w-sm">
        <!-- Glow ring -->
        <div class="animate-glow-pulse absolute inset-0 rounded-full bg-gradient-to-br from-violet to-fuchsia opacity-30 blur-3xl"></div>

        <!-- Rotating ring -->
        <div class="animate-spin-slow absolute -inset-4 rounded-full border border-dashed border-white/10"></div>
        <div class="animate-spin-slow absolute -inset-8 rounded-full border border-dashed border-white/5" style="animation-direction: reverse;"></div>

        <!-- Avatar container -->
        <div class="relative aspect-square overflow-hidden rounded-full border-2 border-white/10 bg-surface">
          <img
            src={profile.avatar}
            alt={profile.name}
            class="h-full w-full object-cover"
          />
          <!-- Overlay gradient -->
          <div class="absolute inset-0 bg-gradient-to-t from-base/60 via-transparent to-transparent"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 lg:flex">
    <span class="text-xs text-dim">Scroll</span>
    <div class="flex h-8 w-5 justify-center rounded-full border border-border pt-2">
      <div class="animate-float h-1.5 w-1 rounded-full bg-violet"></div>
    </div>
  </div>
</section>
