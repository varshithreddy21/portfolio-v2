---
import Icon from "./Icon.astro";

interface Props {
  profile: {
    name: string;
    firstName: string;
    headline: string;
    location: string;
    email: string;
    avatar: string;
    resumeUrl: string;
    about: string;
    stats: Array<{ label: string; value: string }>;
    socials: Array<{ label: string; url: string; icon: string }>;
  };
}

const { profile } = Astro.props;

// Words for the typing animation
const roles = [
  "Finance Professional",
  "Venture Debt Specialist",
  "Credit & Risk Analyst",
  "Deal Execution Expert",
  "Private Credit Investor",
];
---

<section id="home" class="relative flex min-h-screen items-center overflow-hidden pt-24">
  <!-- Floating decorative elements -->
  <div class="animate-float absolute top-1/4 left-[10%] hidden h-3 w-3 rounded-full bg-violet/60 blur-[1px] lg:block"></div>
  <div class="animate-float-slow absolute top-1/3 right-[15%] hidden h-4 w-4 rounded-full bg-fuchsia/50 blur-[1px] lg:block"></div>
  <div class="animate-float absolute bottom-1/4 left-[20%] hidden h-2 w-2 rounded-full bg-cyan/70 blur-[1px] lg:block" style="animation-delay: -3s;"></div>
  <div class="animate-float-slow absolute bottom-1/3 right-[8%] hidden h-3 w-3 rounded-full bg-emerald/50 blur-[1px] lg:block" style="animation-delay: -4s;"></div>

  <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 px-6 lg:grid-cols-12 lg:px-8">
    <!-- Left: Text content -->
    <div class="lg:col-span-7">
      <!-- Badge -->
      <div class="reveal mb-6 inline-flex items-center gap-2 rounded-full border border-white/10 bg-surface/50 px-4 py-1.5 text-xs text-muted backdrop-blur-sm">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald"></span>
        </span>
        Available for new opportunities
      </div>

      <!-- Greeting -->
      <div class="reveal reveal-left delay-1 mb-2 font-mono text-sm text-violet">
        <span class="text-muted">$</span> whoami
      </div>

      <!-- Name -->
      <h1 class="reveal reveal-left delay-2 font-display text-5xl font-bold leading-tight tracking-tight sm:text-6xl lg:text-7xl">
        <span class="text-text">Hi, I'm </span>
        <span class="text-gradient-animated">{profile.name}</span>
      </h1>

      <!-- Typing role -->
      <div class="reveal reveal-left delay-3 mt-4 flex items-center font-display text-2xl font-medium text-muted sm:text-3xl">
        <span class="text-text" id="typed-text"></span>
        <span class="animate-blink ml-1 inline-block h-7 w-[3px] bg-fuchsia sm:h-8"></span>
      </div>

      <!-- Location -->
      <div class="reveal reveal-left delay-4 mt-4 flex items-center gap-2 text-sm text-dim">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        {profile.location}
      </div>

      <!-- Description -->
      <p class="reveal reveal-left delay-5 mt-6 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
        {profile.about}
      </p>

      <!-- CTAs -->
      <div class="reveal reveal-left delay-6 mt-8 flex flex-wrap items-center gap-4">
        <a
          href="#projects"
          class="group relative overflow-hidden rounded-xl bg-gradient-to-r from-violet to-fuchsia px-6 py-3 text-sm font-semibold text-white transition-all hover:shadow-lg hover:shadow-violet/30"
        >
          <span class="relative z-10 flex items-center gap-2">
            View My Work
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </span>
          <div class="absolute inset-0 -translate-x-full bg-gradient-to-r from-fuchsia to-cyan transition-transform duration-300 group-hover:translate-x-0"></div>
        </a>

        <a
          href="#contact"
          class="rounded-xl border border-border bg-surface/50 px-6 py-3 text-sm font-semibold text-text backdrop-blur-sm transition-all hover:border-violet/50 hover:bg-surface"
        >
          Get in Touch
        </a>

        {
          profile.resumeUrl && (
            <a
              href={profile.resumeUrl}
              target="_blank"
              rel="noopener"
              class="flex items-center gap-2 text-sm font-medium text-muted transition-colors hover:text-text"
            >
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              Resume
            </a>
          )
        }
      </div>

      <!-- Socials -->
      <div class="reveal reveal-left delay-6 mt-8 flex items-center gap-3">
        {
          profile.socials.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-10 w-10 items-center justify-center rounded-lg border border-border bg-surface/50 text-muted transition-all hover:border-violet/50 hover:text-violet hover:shadow-md hover:shadow-violet/10"
              aria-label={social.label}
            >
              <Icon name={social.icon} class="h-4 w-4" />
              <span class="sr-only">{social.label}</span>
            </a>
          ))
        }
      </div>
    </div>

    <!-- Right: Avatar / visual -->
    <div class="reveal reveal-scale delay-3 lg:col-span-5">
      <div class="relative mx-auto max-w-sm">
        <!-- Glow ring -->
        <div class="animate-glow-pulse absolute inset-0 rounded-full bg-gradient-to-br from-violet to-fuchsia opacity-30 blur-3xl"></div>

        <!-- Rotating ring -->
        <div class="animate-spin-slow absolute -inset-4 rounded-full border border-dashed border-white/10"></div>
        <div class="animate-spin-slow absolute -inset-8 rounded-full border border-dashed border-white/5" style="animation-direction: reverse;"></div>

        <!-- Avatar container -->
        <div class="relative aspect-square overflow-hidden rounded-full border-2 border-white/10 bg-surface">
          <img
            src={profile.avatar}
            alt={profile.name}
            class="h-full w-full object-cover"
          />
          <!-- Overlay gradient -->
          <div class="absolute inset-0 bg-gradient-to-t from-base/60 via-transparent to-transparent"></div>
        </div>

        <!-- Floating badges -->
        <div class="animate-float absolute -right-4 top-1/4 flex items-center gap-2 rounded-xl border border-border glass-strong px-3 py-2 text-xs font-medium text-text">
          <span class="flex h-2 w-2 rounded-full bg-emerald"></span>
          Open to Work
        </div>

        <div class="animate-float-slow absolute -left-6 bottom-1/4 rounded-xl border border-border glass-strong px-3 py-2 text-xs font-medium text-text">
          <span class="text-gradient font-bold">5+</span> Years Exp
        </div>

        <div class="animate-float absolute -bottom-2 right-1/4 rounded-xl border border-border glass-strong px-3 py-2 text-xs font-medium text-text" style="animation-delay: -2s;">
          <span class="text-gradient font-bold">40+</span> Projects
        </div>
      </div>
    </div>
  </div>

  <!-- Stats bar -->
  <div class="absolute bottom-0 left-0 right-0 border-t border-white/5 bg-surface/30 backdrop-blur-sm">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-4 px-6 py-6 sm:grid-cols-4 lg:px-8">
      {
        profile.stats?.map((stat, i) => (
          <div class={`reveal reveal-scale delay-${i + 1} text-center`}>
            <div class="font-display text-3xl font-bold text-gradient sm:text-4xl">
              {stat.value}
            </div>
            <div class="mt-1 text-xs text-dim sm:text-sm">{stat.label}</div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-28 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 lg:flex">
    <span class="text-xs text-dim">Scroll</span>
    <div class="flex h-8 w-5 justify-center rounded-full border border-border pt-2">
      <div class="animate-float h-1.5 w-1 rounded-full bg-violet"></div>
    </div>
  </div>
</section>

<!-- Inline SVG icons data -->
<script define:vars={{ roles }}>
  // Typing animation
  const typedEl = document.getElementById("typed-text");
  let roleIndex = 0;
  let charIndex = 0;
  let isDeleting = false;

  function typeRole() {
    const current = roles[roleIndex];
    if (isDeleting) {
      charIndex--;
    } else {
      charIndex++;
    }
    if (typedEl) {
      typedEl.textContent = current.substring(0, charIndex);
    }

    let delay = isDeleting ? 40 : 80;

    if (!isDeleting && charIndex === current.length) {
      delay = 2000;
      isDeleting = true;
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      roleIndex = (roleIndex + 1) % roles.length;
      delay = 300;
    }

    setTimeout(typeRole, delay);
  }

  if (typedEl) typeRole();
</script>
