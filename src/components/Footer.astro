---
import Icon from "./Icon.astro";

interface Props {
  profile: {
    name: string;
    firstName: string;
    email: string;
    socials: Array<{ label: string; url: string; icon: string }>;
  };
}

const { profile } = Astro.props;
const isHome = Astro.url.pathname === "/";
const year = new Date().getFullYear();
---

<footer class="relative border-t border-white/5 py-12">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
      <!-- Logo -->
      <div class="flex items-center gap-3">
        <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-gradient-to-br from-violet to-fuchsia text-xs font-bold text-white">
          {profile.firstName.slice(0, 2).toUpperCase()}
        </div>
        <div>
          <div class="font-display text-sm font-semibold text-text">{profile.name}</div>
        </div>
      </div>

      <!-- Quick links -->
      <nav class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
        <a href={isHome ? "#home" : "/#home"} class="text-muted transition-colors hover:text-text">About</a>
        <a href="/blog" class="text-muted transition-colors hover:text-text">Blog</a>
        <a href="/rss.xml" class="flex items-center gap-1 text-muted transition-colors hover:text-violet">
          <Icon name="rss" class="h-3.5 w-3.5" />
          RSS
        </a>
      </nav>

      <!-- Socials -->
      <div class="flex gap-2">
        {
          profile.socials.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-8 w-8 items-center justify-center rounded-lg border border-border bg-surface text-dim transition-all hover:border-violet/50 hover:text-violet"
              aria-label={social.label}
            >
              <Icon name={social.icon} class="h-3.5 w-3.5" />
            </a>
          ))
        }
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-8 flex flex-col items-center justify-between gap-2 border-t border-white/5 pt-6 text-xs text-dim sm:flex-row">
      <p>&copy; {year} {profile.name}. All rights reserved.</p>
      <p>Built with Astro & Tailwind CSS</p>
    </div>
  </div>
</footer>
